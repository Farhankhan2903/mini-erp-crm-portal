{
  "info": {
    "_postman_id": "a9f8e4b2-3c1d-4e5f-9a8b-7c6d5e4f3a2b",
    "name": "Mini ERP + CRM Portal - Postman Collection",
    "description": "Complete Postman Collection for Mini ERP + CRM Portal including Auth, Customer CRM, Product & Inventory, Sales Challan ERP, and Dashboard Analytics Modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "challanId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication API",
      "item": [
        {
          "name": "Login - Admin User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@minierp.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('jwtToken', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Customer CRM Module",
      "item": [
        {
          "name": "Get Customers (Pagination & Sorting)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Product & Inventory Module",
      "item": [
        {
          "name": "Get Products (Low Stock Alerts)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?lowStock=true",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales Challan ERP Module",
      "item": [
        {
          "name": "Get Sales Challans",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sales-challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Dashboard Analytics Module",
      "item": [
        {
          "name": "Get Dashboard Metrics (/dashboard/metrics)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "metrics"]
            },
            "description": "Fetches high-performance real-time metrics for Dashboard Cards (Total Customers, Total Products, Today's Challans, Low Stock Count, Total Inventory Value) and Recent Activity Lists (Recent Challans, Recent Customers)."
          }
        }
      ]
    }
  ]
}

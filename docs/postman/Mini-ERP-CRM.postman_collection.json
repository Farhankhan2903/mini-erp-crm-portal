        },
        {
          "name": "Add Follow-Up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Spoke with procurement manager. They require a demo next week.\",\n  \"followUpDate\": \"2026-08-25T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}", "notes"]
            },
            "description": "Appends a follow-up note to the customer's audit trail and updates the follow-up date."
          }

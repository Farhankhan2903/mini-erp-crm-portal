    {
      "name": "2. Customer CRM",
      "description": "Full CRUD operations for the Customer CRM module with pagination, search, and notes history.",
      "item": [
        {
          "name": "List Customers (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('customerId', res.data[0].id);",
                  "    console.log('✅ customerId saved:', res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/customers?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                { "key": "page",       "value": "1" },
                { "key": "limit",      "value": "10" },
                { "key": "sortBy",     "value": "createdAt" },
                { "key": "sortOrder",  "value": "desc" },
                { "key": "search",     "value": "",    "disabled": true },
                { "key": "status",     "value": "ACTIVE", "disabled": true },
                { "key": "customerType","value": "CORPORATE", "disabled": true }

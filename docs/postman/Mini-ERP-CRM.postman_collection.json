    {
      "name": "4. Stock Movements",
      "description": "Inventory adjustment log. Records IN / OUT / ADJUSTMENT movements with full audit trail.",
      "item": [
        {
          "name": "List Stock Movements (Paginated)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/stock-movements?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["stock-movements"],
              "query": [
                { "key": "page",         "value": "1" },
                { "key": "limit",        "value": "20" },
                { "key": "productId",    "value": "",    "disabled": true },
                { "key": "movementType", "value": "IN",  "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Log Stock IN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 15,\n  \"movementType\": \"IN\",\n  \"reason\": \"Restocked from supplier PO-2026-0042\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "description": "Increases product stock by the given quantity. Creates a stock movement audit record."
          }
        },
        {
          "name": "Log Stock OUT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 3,\n  \"movementType\": \"OUT\",\n  \"reason\": \"Issued for internal use — IT department\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "description": "Decreases product stock. Returns 400 if stock would go negative (negative stock prevention)."
          }
        },
        {
          "name": "Stock ADJUSTMENT (Set Exact Count)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 25,\n  \"movementType\": \"ADJUSTMENT\",\n  \"reason\": \"Physical stock count reconciliation — Q3 audit\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/stock-movements", "host": ["{{baseUrl}}"], "path": ["stock-movements"] },
            "description": "Sets the exact stock count (absolute value, not delta). Used for physical audit corrections."
          }
        }
      ]
    },
    {
      "name": "5. Sales Challans",
      "description": "ERP Sales Challan module. Auto-numbered, product snapshot, and transactional stock deduction.",
      "item": [
        {
          "name": "List Sales Challans (Paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('challanId', res.data[0].id);",
                  "    console.log('✅ challanId saved:', res.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-challans?page=1&limit=10&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans"],
              "query": [
                { "key": "page",       "value": "1" },
                { "key": "limit",      "value": "10" },
                { "key": "sortBy",     "value": "createdAt" },
                { "key": "sortOrder",  "value": "desc" },
                { "key": "status",     "value": "DRAFT",         "disabled": true },
                { "key": "customerId", "value": "{{customerId}}", "disabled": true },
                { "key": "search",     "value": "",              "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Sales Challan by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales-challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans", "{{challanId}}"]
            },
            "description": "Returns full challan detail including customer, items (product snapshot), and creator info."
          }
        },
        {
          "name": "Create Sales Challan (DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('challanId', res.data.id);",
                  "    console.log('✅ New challanId saved:', res.data.id);",
                  "    console.log('✅ Challan Number:', res.data.challanNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"DRAFT\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales-challans", "host": ["{{baseUrl}}"], "path": ["sales-challans"] },
            "description": "Creates a new challan in DRAFT status. Auto-generates challan number (SCH-YYYYMMDD-XXXX). Captures product snapshot (name, SKU, price) at time of creation."
          }
        },
        {
          "name": "Create Sales Challan (CONFIRMED — triggers stock deduction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"status\": \"CONFIRMED\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales-challans", "host": ["{{baseUrl}}"], "path": ["sales-challans"] },
            "description": "Creates a challan directly in CONFIRMED status. Immediately triggers transactional stock deduction. Returns 400 if insufficient stock."
          }
        },
        {
          "name": "Update Challan Status → CONFIRMED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sales-challans/{{challanId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["sales-challans", "{{challanId}}", "status"]
            },
            "description": "Transitions DRAFT → CONFIRMED. Triggers transactional stock deduction. Business rule: cannot exceed available stock."
          }
        },
        {
          "name": "Update Challan Status → DISPATCHED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },

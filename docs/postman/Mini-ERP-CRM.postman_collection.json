              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            },
            "description": "Returns full customer detail including notes history and past sales challans."
          }
        },
        {
          "name": "Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('customerId', res.data.id);",
                  "    console.log('✅ New customerId saved:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zenith Manufacturing Ltd\",\n  \"mobile\": \"+91 9123456780\",\n  \"email\": \"contact@zenithmfg.com\",\n  \"businessName\": \"Zenith Manufacturing Limited\",\n  \"gst\": \"27ZZZMF5432X1Z9\",\n  \"customerType\": \"WHOLESALE\",\n  \"address\": \"Plot 77, Industrial Area Phase 2, Pune, Maharashtra 411014\",\n  \"status\": \"PROSPECT\",\n  \"notes\": \"Interested in bulk server rack orders.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] },
            "description": "Create a new customer. ADMIN and SALES roles only."
          }
        },
